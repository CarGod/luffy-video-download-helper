{
  "manifest_version": 3,
  "name": "Luffy Video Download Helper",
  "version": "0.4.5",
  "description": "发现网页视频，下载 MP4 与 HLS 点播。本地处理，无账号、无会员。",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "activeTab",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Luffy Video Download Helper",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "incognito": "not_allowed",
  "key": ""
}
